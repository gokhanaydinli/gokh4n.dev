---
// ============================================================================
// /blog — bütün yazılar, yeniden eskiye.
//
// Ana ekranla aynı dil: vitrinde en yeni yazı, altında bütün yazılar alt
// alta. Bir yazının üstüne gelince vitrin onu gösteriyor.
// Taslak işaretli olanlar burada görünmez; yazarken yayına sızmasınlar diye.
// ============================================================================
import { getCollection, type CollectionEntry } from "astro:content";
import Temel from "../../layouts/Temel.astro";
import Vitrin from "../../components/Vitrin.astro";
import Raf from "../../components/Raf.astro";
import Kart from "../../components/Kart.astro";
import { yaziVitrini, kisaTarih } from "../../lib/vitrin";
import { okumaSuresi } from "../../lib/okuma";

type Yazi = CollectionEntry<"blog">;

const yazilar = (await getCollection("blog", ({ data }: Yazi) => !data.taslak)).sort(
  (a: Yazi, b: Yazi) => b.data.tarih.getTime() - a.data.tarih.getTime()
);
---

<Temel
  baslik="Blog — gokh4n.dev"
  aciklama="Öğrendiklerim, denediklerim, başıma gelenler."
  aktif="blog"
  raflar
>
  {
    yazilar.length === 0 ? (
      <Raf baslik="Blog">
        <Kart ad="Henüz yazı yok" etiket="Blog" />
      </Raf>
    ) : (
      <>
        <Vitrin oge={yaziVitrini(yazilar[0])} canli baslikEtiketi="div" />
        <div class="noktalar" data-noktalar aria-hidden="true" />
        <h1 class="gizli">Blog</h1>
        <Raf baslik="Bütün yazılar" sayi={yazilar.length} liste>
          {yazilar.map((y: Yazi) => (
            <Kart
              adres={`/blog/${y.id}/`}
              ad={y.data.baslik}
              aciklama={y.data.ozet}
              etiket={`Yazı · ${okumaSuresi(y.body)} dk`}
              ust={kisaTarih(y.data.tarih)}
              vitrin={yaziVitrini(y)}
            />
          ))}
        </Raf>
      </>
    )
  }
</Temel>
