---
// ============================================================================
// /blog/<dosya-adi> — tek bir yazı.
//
// Üstte yazının kendi renginde sabit bir vitrin (başlık + özet), altında
// okunaklı gövde, sonunda diğer yazılar rafı. getStaticPaths her Markdown
// dosyası için bir sayfa üretiyor; site tamamen statik.
// ============================================================================
import { getCollection, render, type CollectionEntry } from "astro:content";
import Temel from "../../layouts/Temel.astro";
import Vitrin from "../../components/Vitrin.astro";
import Raf from "../../components/Raf.astro";
import Kart from "../../components/Kart.astro";
import { yaziVitrini, kisaTarih } from "../../lib/vitrin";
import { okumaSuresi } from "../../lib/okuma";

type Yazi = CollectionEntry<"blog">;

export async function getStaticPaths() {
  // Blog listesiyle aynı sıra: yeniden eskiye. Komşular bu sıradan geliyor.
  const yazilar = (await getCollection("blog", ({ data }: Yazi) => !data.taslak)).sort(
    (a: Yazi, b: Yazi) => b.data.tarih.getTime() - a.data.tarih.getTime()
  );
  return yazilar.map((yazi: Yazi, i: number) => ({
    params: { slug: yazi.id },
    props: { yazi, dahaYeni: yazilar[i - 1], dahaEski: yazilar[i + 1] },
  }));
}

interface Props {
  yazi: Yazi;
  dahaYeni?: Yazi;
  dahaEski?: Yazi;
}

const { yazi, dahaYeni, dahaEski } = Astro.props;
const { Content } = await render(yazi);

const tarih = yazi.data.tarih.toLocaleDateString("tr-TR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Temel baslik={`${yazi.data.baslik} — gokh4n.dev`} aciklama={yazi.data.ozet} aktif="blog">
  <Vitrin oge={yaziVitrini(yazi)} dugmesiz />

  <p class="sayfa-bilgi">
    {tarih} · {okumaSuresi(yazi.body)} dk okuma
    {
      yazi.data.etiketler.length > 0 && (
        <>
          {" · "}
          <span class="etiketler">{yazi.data.etiketler.join(" · ")}</span>
        </>
      )
    }
  </p>

  <article class="icerik">
    <Content />
  </article>

  {/* Yazı bitince okuyucu "Bütün yazılar"a dönüp seçmek zorunda kalmasın. */}
  <Raf baslik="Diğer yazılar">
    {
      dahaEski && (
        <Kart
          boy="genis"
          adres={`/blog/${dahaEski.id}/`}
          ad={dahaEski.data.baslik}
          etiket="← Önceki"
          ust={kisaTarih(dahaEski.data.tarih)}
        />
      )
    }
    {
      dahaYeni && (
        <Kart
          boy="genis"
          adres={`/blog/${dahaYeni.id}/`}
          ad={dahaYeni.data.baslik}
          etiket="Sonraki →"
          ust={kisaTarih(dahaYeni.data.tarih)}
        />
      )
    }
    <Kart boy="genis" adres="/blog/" ad="Bütün yazılar" etiket="Blog" ust="→" />
  </Raf>
</Temel>
