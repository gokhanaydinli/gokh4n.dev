---
// ============================================================================
// /blog/<dosya-adi> — tek bir yazı.
//
// getStaticPaths her Markdown dosyası için bir sayfa üretiyor. Site tamamen
// statik derleniyor, sunucuda çalışan hiçbir şey yok.
// ============================================================================
import { getCollection, render, type CollectionEntry } from "astro:content";
import Temel from "../../layouts/Temel.astro";
import { okumaSuresi } from "../../lib/okuma";

type Yazi = CollectionEntry<"blog">;

export async function getStaticPaths() {
  // Blog listesiyle ayni sira: yeniden eskiye. Komsular bu siradan geliyor.
  const yazilar = (await getCollection("blog", ({ data }) => !data.taslak)).sort(
    (a: Yazi, b: Yazi) => b.data.tarih.getTime() - a.data.tarih.getTime()
  );
  return yazilar.map((yazi: Yazi, i: number) => ({
    params: { slug: yazi.id },
    props: {
      yazi,
      dahaYeni: yazilar[i - 1],
      dahaEski: yazilar[i + 1],
    },
  }));
}

interface Props {
  yazi: Yazi;
  dahaYeni?: Yazi;
  dahaEski?: Yazi;
}

const { yazi, dahaYeni, dahaEski } = Astro.props;
const { Content } = await render(yazi);

const tarih = yazi.data.tarih.toLocaleDateString("tr-TR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const dakika = okumaSuresi(yazi.body);
---

<Temel
  baslik={`${yazi.data.baslik} — gokh4n.dev`}
  aciklama={yazi.data.ozet}
  aktif="blog"
>
  <div class="hucre serit">
    <span>Blog</span>
    <span>{tarih} · {dakika} dk</span>
  </div>

  <header class="hucre yazi-basligi">
    <h1>{yazi.data.baslik}</h1>
    {
      yazi.data.etiketler.length > 0 && (
        <p class="yazi-ustveri">{yazi.data.etiketler.join(" · ")}</p>
      )
    }
    <p class="yazi-ozet">{yazi.data.ozet}</p>
  </header>

  <article class="hucre icerik">
    <Content />
  </article>

  {/* Yazi bitince okuyucu "Butun yazilar"a donup secmek zorunda kalmasin.
      Tek komsu varsa o tek baglanti satirin tamamini kapliyor. */}
  {
    (dahaEski || dahaYeni) && (
      <nav class="hucre komsular" aria-label="Diğer yazılar">
        {dahaEski && (
          <a class="komsu" href={`/blog/${dahaEski.id}/`} rel="prev">
            <span class="komsu-yon">← Önceki</span>
            <span class="komsu-baslik">{dahaEski.data.baslik}</span>
          </a>
        )}
        {dahaYeni && (
          <a class="komsu sonraki" href={`/blog/${dahaYeni.id}/`} rel="next">
            <span class="komsu-yon">Sonraki →</span>
            <span class="komsu-baslik">{dahaYeni.data.baslik}</span>
          </a>
        )}
      </nav>
    )
  }

  <a class="hucre bag" href="/blog/">
    <span aria-hidden="true">←</span>
    <span>Bütün yazılar</span>
  </a>
</Temel>
