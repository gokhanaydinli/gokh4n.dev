---
// ============================================================================
// Ana sayfa — TV ana ekranı.
//
// Üstte vitrin, altında raflar: çalışmalar, son yazılar, bağlantılar. Bir
// kartın üstüne gelince (ya da klavyeyle seçince) vitrin o kartı gösteriyor.
// JS yoksa vitrin ilk projeyle basılı kalıyor, kartlar düz bağlantı.
// ============================================================================
import { getCollection, type CollectionEntry } from "astro:content";
import Temel from "../layouts/Temel.astro";
import Vitrin from "../components/Vitrin.astro";
import Raf from "../components/Raf.astro";
import Kart from "../components/Kart.astro";
import { projeler } from "../data/projeler";
import { projeVitrini, yaziVitrini, kisaTarih } from "../lib/vitrin";
import { okumaSuresi } from "../lib/okuma";

type Yazi = CollectionEntry<"blog">;

// Rafta en fazla bu kadar yazı; fazlası blog sayfasında.
const SON_YAZI = 4;
const yazilar = (await getCollection("blog", ({ data }: Yazi) => !data.taslak))
  .sort((a: Yazi, b: Yazi) => b.data.tarih.getTime() - a.data.tarih.getTime())
  .slice(0, SON_YAZI);
---

<Temel baslik="gokh4n.dev" aciklama="Çalışmalar ve blog." aktif="ana" raflar>
  <Vitrin oge={projeVitrini(projeler[0])} canli baslikEtiketi="div" />
  <div class="noktalar" data-noktalar aria-hidden="true"></div>

  <h1 class="gizli">gokh4n.dev — çalışmalar ve blog</h1>

  <Raf baslik="Çalışmalar" sayi={projeler.length}>
    {
      projeler.map((p) => (
        <Kart
          adres={p.adres}
          ad={p.ad}
          dil={p.dil}
          etiket={p.etiket}
          canli={p.canli}
          ust={p.adres.startsWith("http") ? "GitHub ↗" : p.yil}
          vitrin={projeVitrini(p)}
        />
      ))
    }
  </Raf>

  <Raf baslik="Blog">
    {
      yazilar.map((y: Yazi) => (
        <Kart
          boy="genis"
          adres={`/blog/${y.id}/`}
          ad={y.data.baslik}
          etiket={`Yazı · ${okumaSuresi(y.body)} dk`}
          ust={kisaTarih(y.data.tarih)}
          vitrin={yaziVitrini(y)}
        />
      ))
    }
  </Raf>

  <Raf baslik="Bağlantılar">
    <Kart boy="kucuk" adres="/blog/" ad="Bütün yazılar" etiket="Blog" ust="→" />
    <Kart boy="kucuk" adres="https://github.com/gokhanaydinli" ad="GitHub" dil="en" etiket="Bağlantı" ust="↗" />
    <Kart boy="kucuk" adres="/rss.xml" ad="RSS" etiket="Besleme" ust="→" />
  </Raf>
</Temel>
