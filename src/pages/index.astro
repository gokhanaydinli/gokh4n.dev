---
// ============================================================================
// Ana sayfa — çalışmalar dizini.
//
// Blog bilinçli olarak burada değil, üstteki menüden gidiliyor. Projeler ve
// yazılar birbirini bastırmasın diye ayrı duruyorlar.
// ============================================================================
import Temel from "../layouts/Temel.astro";

const projeler = [
  {
    ad: "Oyun Gecesi",
    // Artik dogrudan uygulamaya degil, once proje sayfasina gidiyor:
    // ziyaretci ne oldugunu anlamadan uygulamanin icine dusmesin.
    adres: "/oyun-gecesi/",
    yil: "2026",
    aciklama:
      "Arkadaşlarla telefondan oynanan çok oyunculu parti oyunları. " +
      "Vampir Köylü, Casus Kim, Tabu, Yer Bilme. Oda kur, kodu paylaş.",
    yigin: "Next · Socket.IO · TypeScript",
  },
  {
    ad: "Takip Defteri",
    adres: "/takip/",
    yil: "2026",
    aciklama:
      "Instagram'da kimlerin takipten çıktığını gösterir. Instagram'ın kendi " +
      "veri dışa aktarımını okur — şifre istemez, hiçbir şey sunucuya gitmez.",
    yigin: "Astro · TypeScript",
  },
  {
    ad: "Android TV Toolkit",
    adres: "https://github.com/gokhanaydinli/android-tv-toolkit",
    yil: "2026",
    aciklama:
      "Android TV kutusunu root'suz temizleyen betik ve 36 KB'lık bir ana " +
      "ekran. Her değişikliğin geri alma komutu üretiliyor.",
    yigin: "Java · ADB",
  },
];
---

<Temel baslik="gokh4n.dev" aciklama="Çalışmalar dizini." aktif="ana">
  <div class="hucre serit">
    <span>Çalışmalar</span>
    <span>{String(projeler.length).padStart(2, "0")}</span>
  </div>

  {
    projeler.map((p, i) => (
      <a
        class="hucre is"
        href={p.adres}
        target={p.adres.startsWith("http") ? "_blank" : undefined}
        rel={p.adres.startsWith("http") ? "noreferrer" : undefined}
      >
        <span class="sira">{String(i + 1).padStart(2, "0")}</span>
        <span class="govde">
          <span class="ad">{p.ad}</span>
          <p class="aciklama">{p.aciklama}</p>
          <p class="yigin" lang="en">{p.yigin}</p>
        </span>
        <span class="sag">
          <span>{p.yil}</span>
          {/* Siteden ayrilan baglantilarda ok yerine disari isareti — alt
              bilgideki GitHub baglantisiyla ayni dil. */}
          <span class="ok" aria-hidden="true">
            {p.adres.startsWith("http") ? "↗" : "→"}
          </span>
        </span>
      </a>
    ))
  }
</Temel>
