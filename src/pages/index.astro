---
// ============================================================================
// Ana sayfa — çalışmalar dizini.
//
// Blog bilinçli olarak burada değil, üstteki menüden gidiliyor. Projeler ve
// yazılar birbirini bastırmasın diye ayrı duruyorlar.
// ============================================================================
import Temel from "../layouts/Temel.astro";

// Proje adlari ekranda buyuk harfe cevriliyor ve sayfa dili Turkce oldugu
// icin "i" -> "İ" oluyor: Ingilizce adlarda "ANDROİD TV TOOLKİT" cikiyordu.
// dil: "en" o satirin lang'ini degistiriyor, donusum Ingilizce kurala gore
// yapiliyor. Turkce adlarda (TAKİP DEFTERİ) mevcut hali zaten dogru.
//
// durum: satirin ustundeki kucuk etiket. Ziyaretci tiklamadan once neyle
// karsilasacagini bilsin — calisan bir uygulama mi, kaynak kod mu.
const projeler: {
  ad: string;
  dil?: "en";
  durum: string;
  adres: string;
  yil: string;
  aciklama: string;
  yigin: string;
}[] = [
  {
    ad: "Oyun Gecesi",
    durum: "Canlı",
    // Artik dogrudan uygulamaya degil, once proje sayfasina gidiyor:
    // ziyaretci ne oldugunu anlamadan uygulamanin icine dusmesin.
    adres: "/oyun-gecesi/",
    yil: "2026",
    aciklama:
      "Arkadaşlarla telefondan oynanan çok oyunculu parti oyunları. " +
      "Vampir Köylü, Casus Kim, Tabu, Yer Bilme. Oda kur, kodu paylaş.",
    yigin: "Next · Socket.IO · TypeScript",
  },
  {
    ad: "Takip Defteri",
    durum: "Canlı",
    adres: "/takip/",
    yil: "2026",
    aciklama:
      "Instagram'da kimlerin takipten çıktığını gösterir. Instagram'ın kendi " +
      "veri dışa aktarımını okur — şifre istemez, hiçbir şey sunucuya gitmez.",
    // Kendi reposuna tasinirken Next'e gecti; takip.astro'daki yiginla ayni.
    yigin: "Next · TypeScript · Tailwind",
  },
  {
    ad: "Android TV Toolkit",
    dil: "en",
    durum: "Açık kaynak",
    adres: "https://github.com/gokhanaydinli/android-tv-toolkit",
    yil: "2026",
    aciklama:
      "Android TV kutusunu root'suz temizleyen betik ve 36 KB'lık bir ana " +
      "ekran. Her değişikliğin geri alma komutu üretiliyor.",
    yigin: "Java · ADB",
  },
];
---

<Temel baslik="gokh4n.dev" aciklama="Çalışmalar dizini." aktif="ana">
  {/* Siteye ilk gelen kimin sitesinde oldugunu bilmiyordu: kunye bir alan
      adi, altindaki liste projeler. Iki cumle o boslugu kapatiyor. */}
  <p class="hucre giris">
    Merhaba, ben <b>Gökhan</b>. Arkadaşlarla oynadığımız oyunlardan evdeki
    TV kutusuna kadar, ihtiyaç duyduğum şeyleri kendim yapıyorum. Burada o
    işler var; yaparken öğrendiklerimi de bloga yazıyorum.
  </p>

  <div class="hucre serit">
    <span>Çalışmalar</span>
    <span>{String(projeler.length).padStart(2, "0")}</span>
  </div>

  {
    projeler.map((p, i) => (
      <a
        class="hucre is"
        href={p.adres}
        target={p.adres.startsWith("http") ? "_blank" : undefined}
        rel={p.adres.startsWith("http") ? "noreferrer" : undefined}
      >
        <span class="sira">{String(i + 1).padStart(2, "0")}</span>
        <span class="govde">
          <span class="durum">{p.durum}</span>
          <span class="ad" lang={p.dil}>{p.ad}</span>
          <p class="aciklama">{p.aciklama}</p>
          <p class="yigin" lang="en">{p.yigin}</p>
        </span>
        <span class="sag">
          <span>{p.yil}</span>
          {/* Siteden ayrilan baglantilarda ok yerine disari isareti — alt
              bilgideki GitHub baglantisiyla ayni dil. */}
          <span class="ok" aria-hidden="true">
            {p.adres.startsWith("http") ? "↗" : "→"}
          </span>
        </span>
      </a>
    ))
  }
</Temel>
