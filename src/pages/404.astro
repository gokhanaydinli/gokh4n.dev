---
// ============================================================================
// 404 — olmayan adres.
//
// Bu sayfa olmadan Caddy'nin çıplak "404 page not found" metni görünüyordu:
// tasarım yok, siteye dönüş yolu yok. Astro bu dosyayı görünce dist/404.html
// üretiyor, Caddy de bulunamayan istekleri ona yönlendiriyor.
//
// TV'de yayın kesilince çıkan renk çubukları: "sinyal yok". Salt CSS.
// ============================================================================
import Temel from "../layouts/Temel.astro";
import Raf from "../components/Raf.astro";
import Kart from "../components/Kart.astro";
---

<Temel baslik="Bulunamadı — gokh4n.dev" aciklama="Böyle bir sayfa yok." raflar>
  <section class="sinyal">
    <div class="sinyal-kutu">
      <b>SİNYAL YOK</b>
      <span>404 · böyle bir sayfa yok</span>
    </div>
  </section>

  <h1 class="gizli">Böyle bir sayfa yok</h1>

  <Raf baslik="Kanal değiştir">
    <Kart boy="genis" adres="/" ad="Ana ekran" etiket="Kanal 1" ust="→" />
    <Kart boy="genis" adres="/blog/" ad="Blog" etiket="Kanal 2" ust="→" />
  </Raf>
</Temel>
