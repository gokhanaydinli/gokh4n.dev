---
// ============================================================================
// /oyun-gecesi — proje sayfası.
//
// Ana sayfadaki kart eskiden doğrudan games.gokh4n.dev'e atıyordu; ziyaretçi
// projeyi hiç anlamadan uygulamanın içine düşüyordu. Bu sayfa araya girip
// oyunları tanıtıyor — teknik anlatım bilerek yok, ziyaretçi oyunu merak
// ediyor.
//
// Yeni CSS yazılmadı: serit / is / icerik / bag sınıfları hazırdı.
// ============================================================================
import Temel from "../layouts/Temel.astro";

const oyunlar = [
  {
    ad: "Vampir Köylü",
    kisi: "4–24",
    aciklama:
      "Gece herkes uyur; vampirler gizlice bir kurban seçer, doktor birini " +
      "korur, gözcü birinin masum olup olmadığını sorar. Sabah kimin " +
      "öldüğü açıklanır. Gündüz tartışılır ve oylanır — en çok oyu alan " +
      "asılır. Vampirler bitince köy, vampirler sayıca eşitlenince " +
      "vampirler kazanır.",
  },
  {
    ad: "Casus Kim?",
    kisi: "3–24",
    aciklama:
      "Herkes aynı kelimeyi görür, casus görmez. Sırayla birbirinize soru " +
      "sorarsınız; casus kelimeyi bilmediğini belli etmeden idare etmeye " +
      "çalışır. Sonunda oylama: casusu bulursanız kazanırsınız, casus " +
      "kelimeyi tahmin ederse o kazanır.",
  },
  {
    ad: "Tabu",
    kisi: "4–24",
    aciklama:
      "Anlatıcı kartındaki kelimeyi takımına anlatır, ama kartta yazan " +
      "yasaklı kelimeleri kullanamaz. Rakip takımdan biri gözetmen olur, " +
      "kartı görür ve yasaklı kelimeyi söylersen kartı yakar. Süre dolunca " +
      "sıra karşı takıma geçer.",
  },
  {
    ad: "Yer Bilme",
    kisi: "1–24",
    aciklama:
      "Dünyada rastgele bir sokağa bırakılırsın. Etrafa bakıp nerede " +
      "olduğunu haritada işaretlersin — gerçek yere ne kadar yakınsan o " +
      "kadar puan. Kaç tur oynanacağını baştan seçersiniz, her tur sonunda " +
      "sıralamayı görürsünüz.",
  },
];
---

<Temel
  baslik="Oyun Gecesi — gokh4n.dev"
  aciklama="Arkadaşlarla telefondan oynanan çok oyunculu parti oyunları."
  aktif="ana"
>
  <div class="hucre serit">
    <span>Proje</span>
    <span>2026</span>
  </div>

  <header class="hucre yazi-basligi">
    <h1>Oyun Gecesi</h1>
    <p class="yazi-ozet">
      Arkadaşlarla telefondan oynanan çok oyunculu parti oyunları. Biri oda
      kurar, kodu paylaşır, herkes kendi telefonundan katılır. Kurulum yok,
      uygulama indirmek yok — tarayıcı yeter.
    </p>
    <p class="yazi-ustveri" lang="en">
      Next · Socket.IO · TypeScript · Astro
    </p>
  </header>

  <div class="hucre serit">
    <span>Oyunlar</span>
    <span>{String(oyunlar.length).padStart(2, "0")}</span>
  </div>

  {
    oyunlar.map((o, i) => (
      <div class="hucre is durgun">
        <span class="sira">{String(i + 1).padStart(2, "0")}</span>
        <span class="govde">
          <span class="ad">{o.ad}</span>
          <p class="aciklama">{o.aciklama}</p>
        </span>
        <span class="sag">
          <span>{o.kisi}</span>
        </span>
      </div>
    ))
  }

  <a class="hucre bag" href="https://games.gokh4n.dev">
    <span>Oyna</span>
    <span aria-hidden="true">↗</span>
  </a>
</Temel>
