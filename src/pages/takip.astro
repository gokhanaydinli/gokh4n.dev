---
// ============================================================================
// /takip — proje sayfası.
//
// Araç önce burada, bu sayfanın içinde çalışıyordu. Arayüzü JavaScript ile
// üretilen listelerden oluşuyor ve Astro'nun kapsamlı stilleri (şablonda
// yazılı olmayan elemanlara uygulanmıyor) yüzünden sürekli kırılıyordu.
// Kendi projesine taşındı: analiz.gokh4n.dev
//
// Burada kalan şey, oyun-gecesi.astro ile aynı kalıpta bir tanıtım: ziyaretçi
// aracın ne olduğunu anlamadan içine düşmesin.
// ============================================================================
import Temel from "../layouts/Temel.astro";
import Vitrin from "../components/Vitrin.astro";
import Raf from "../components/Raf.astro";
import Kart from "../components/Kart.astro";
import { proje } from "../data/projeler";
import { projeVitrini } from "../lib/vitrin";

const bu = proje("Takip Defteri");

const ozellikler = [
  {
    ad: "Takipten çıkanlar",
    aciklama:
      "İki farklı tarihteki listeyi karşılaştırır. Tek bir dışa aktarım " +
      "yalnızca “kim beni geri takip etmiyor” diyebilir; “kim çıktı” için " +
      "geçmiş gerekiyor ve araç onu tutuyor.",
  },
  {
    ad: "Şifre istemiyor",
    aciklama:
      "Instagram'ın resmî API'si takipçi listesini hiçbir koşulda vermiyor. " +
      "Araç, Instagram'ın kullanıcıya kendi verdiği veri dışa aktarımını " +
      "okuyor — hesabı riske atan bir giriş ya da kazıma yok.",
  },
  {
    ad: "Hiçbir şey sunucuya gitmiyor",
    aciklama:
      "Dosya tarayıcıda açılıyor, karşılaştırma tarayıcıda yapılıyor, geçmiş " +
      "tarayıcıda saklanıyor. Sayfa statik; arkasında çalışan bir şey yok.",
  },
];
---

<Temel
  baslik="Takip Defteri — gokh4n.dev"
  aciklama="Instagram'da kimlerin takipten çıktığını gösteren araç."
  aktif="ana"
>
  <Vitrin
    oge={{
      ...projeVitrini(bu),
      aciklama:
        "Instagram'ın sana verdiği veri dışa aktarımını okur, önceki kayıtla " +
        "karşılaştırır. Şifre istemez, hiçbir şey sunucuya gitmez.",
      adres: "https://analiz.gokh4n.dev",
      dugme: "Aracı aç",
      disari: true,
    }}
  />

  <Raf baslik="Ne yapıyor" sayi={ozellikler.length} liste>
    {ozellikler.map((o) => <Kart ad={o.ad} aciklama={o.aciklama} />)}
  </Raf>

  <p class="sayfa-bilgi" lang="en">{bu.yigin}</p>
</Temel>
