---
// ============================================================================
// Tüm sayfaların paylaştığı kabuk: <head>, künye, gezinme, alt bilgi.
//
// Sayfalar sadece kendi içeriğini yazar; başlık/menü/footer buradan gelir.
// Böylece menüye bir bağlantı eklemek tek dosyada değişiklik demek.
// ============================================================================
import "../styles/global.css";

interface Props {
  baslik: string;
  aciklama?: string;
  /** Gezinmede hangi bağlantı işaretli olacak. */
  aktif?: "ana" | "blog";
}

const {
  baslik,
  aciklama = "Blog ve çalışmalar.",
  aktif,
} = Astro.props;

const yil = new Date().getFullYear();
const kanonik = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />

    {/* Tema secimi sayfa boyanmadan ONCE uygulanmali. Aksi halde koyu tema
        secili olsa bile her acilista bir anlik beyaz parlama olur. Bu yuzden
        burada, <body>'den once, senkron calisiyor. */}
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add("js");
        try {
          var t = localStorage.getItem("tema");
          if (t === "koyu" || t === "acik") h.setAttribute("data-tema", t);
        } catch (e) {
          /* gizli sekmede localStorage erisimi hata verebilir */
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{baslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={kanonik} />

    {/* Site şimdilik aramaya kapalı. Açmak istendiğinde bu satır kalkar
        ve public/robots.txt güncellenir — iki yerde tek değişiklik. */}
    <meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={baslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={kanonik} />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23e9e6df'/><rect x='3' y='3' width='26' height='26' fill='none' stroke='%230d0d0d' stroke-width='3'/><rect x='10' y='10' width='12' height='12' fill='%23ff3b00'/></svg>"
    />

    <link rel="alternate" type="application/rss+xml" title="gokh4n.dev" href="/rss.xml" />

    {/* Speculation Rules — sayfa gecislerini anlik yapar.
        Tarayiciya "kullanici bu baglantiya gitmek uzere gorunuyorsa sayfayi
        simdiden hazirla" diyor. eagerness: moderate = imlec baglantinin
        uzerine gelince (masaustu) ya da parmak dokununca (mobil).

        ClientRouter'dan farki: hic JavaScript calismiyor, bu sadece
        bildirimsel bir ipucu. Destekleyen tarayici (Chrome, Edge, Android
        Chrome) faydalaniyor; desteklemeyen (Safari) gormezden geliyor,
        hicbir maliyeti olmuyor. */}
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          { "where": { "href_matches": "/*" }, "eagerness": "moderate" }
        ]
      }
    </script>

  </head>

  <body>
    <main>
      <div class="cerceve">
        <div class="hucre kunye-satir">
          <a class="kunye" href="/">
            gokh4n<b>.</b>dev
          </a>

          <div class="ust-sag">
            {/* Canlı saat. Site statik derlendiği için derleme anındaki
                tarihi basmak yanlış olur; değerleri tarayıcı yazıyor
                (betik sayfanın sonunda). */}
            <div class="saat" aria-hidden="true">
              <span class="saat-ust">
                <span data-saat="gun">&nbsp;</span>
                <span class="ayirac">·</span>
                <span data-saat="tarih">&nbsp;</span>
              </span>
              <span data-saat="vakit">&nbsp;</span>
            </div>

            {/* Mermi gostergesi. Nisangah ates ettikce dusuyor, R ile
                doluyor. JS kapaliysa gorunmuyor. */}
            <div class="mermi" data-mermi data-bos="hayir" aria-hidden="true">
              <span>Mermi</span>
              <span class="mermi-sayi"><span data-mermi-kalan>30</span>/30</span>
              <span class="mermi-ipucu">· R</span>
            </div>

            {/* Vuruş sayacı — kenar kolonlarındaki figürlerden kaç tanesi
                devrildi. Tarayıcıda saklanıyor, sayfa değişince sıfırlanmıyor. */}
            <div class="vurus" data-vurus aria-hidden="true">
              <span>Vuruş</span>
              <span class="vurus-sayi" data-vurus-sayi>00</span>
            </div>

            <div class="kontroller">
              <div class="tema-secici" role="group" aria-label="Tema">
                <button type="button" data-tema-sec="acik">Açık</button>
                <button type="button" data-tema-sec="koyu">Koyu</button>
              </div>

              {/* Ses KENDILIGINDEN BASLAMAZ. Tarayicilar zaten engelliyor,
                  ustelik habersiz baslayan ses rahatsiz edici. Kullanici
                  basarsa baslar, secim hatirlanir ama otomatik acilmaz. */}
              <button
                type="button"
                class="ses"
                data-ses
                aria-pressed="false"
                aria-label="Arka plan sesi"
              >
                Ses
              </button>
            </div>
          </div>
        </div>

        <nav class="gezinme">
          <a href="/" aria-current={aktif === "ana" ? "page" : undefined}>
            Çalışmalar
          </a>
          <a href="/blog/" aria-current={aktif === "blog" ? "page" : undefined}>
            Blog
          </a>
        </nav>

        <slot />

        {/* ÖLÇÜM ŞERİDİ
            Bu sayfanın gerçek ağırlığı. Uydurma değil, tarayıcının
            Performance API'sinden okunuyor — ziyaretçi ne indirdiyse o.

            Sayfa ilk boyandığında değerler henüz belli olmadığı için şerit
            gizli duruyor; ölçüm bitince açılıyor. Böylece boş satır görünmüyor. */}
        <div class="hucre olcum" data-olcum hidden>
          <div class="olcum-satir">
            <span class="olcum-etiket">Bu sayfa</span>
            <span class="olcum-deger" data-olcum-agirlik>—</span>
          </div>
        </div>

        <script is:inline>
          (function () {
            var gun = document.querySelector('[data-saat="gun"]');
            var tarih = document.querySelector('[data-saat="tarih"]');
            var vakit = document.querySelector('[data-saat="vakit"]');
            if (!gun || !tarih || !vakit) return;

            var gunBicimi = new Intl.DateTimeFormat("tr-TR", { weekday: "long" });
            var tarihBicimi = new Intl.DateTimeFormat("tr-TR", {
              day: "2-digit",
              month: "2-digit",
              year: "numeric",
            });
            var vakitBicimi = new Intl.DateTimeFormat("tr-TR", {
              hour: "2-digit",
              minute: "2-digit",
              second: "2-digit",
              hour12: false,
            });

            function yaz() {
              var t = new Date();
              gun.textContent = gunBicimi.format(t);
              tarih.textContent = tarihBicimi.format(t);
              vakit.textContent = vakitBicimi.format(t);
            }

            yaz();
            setInterval(yaz, 1000);
          })();
        </script>
      </div>

      <footer>
        <span>© {yil}</span>
        <a href="https://github.com/gokhanaydinli" target="_blank" rel="noreferrer" lang="en">
          GitHub ↗
        </a>
      </footer>
    </main>

    <script is:inline>
      (function () {
        var dugmeler = document.querySelectorAll("[data-tema-sec]");
        if (!dugmeler.length) return;

        var koyuSorgu = window.matchMedia("(prefers-color-scheme: dark)");

        // Kullanici bir sey secmediyse sistem temasi gecerli sayilir.
        function etkinTema() {
          var secim = document.documentElement.getAttribute("data-tema");
          if (secim === "koyu" || secim === "acik") return secim;
          return koyuSorgu.matches ? "koyu" : "acik";
        }

        function isaretle() {
          var simdiki = etkinTema();
          dugmeler.forEach(function (d) {
            d.setAttribute(
              "aria-pressed",
              d.dataset.temaSec === simdiki ? "true" : "false"
            );
          });
        }

        dugmeler.forEach(function (d) {
          d.addEventListener("click", function () {
            var secilen = d.dataset.temaSec;
            document.documentElement.setAttribute("data-tema", secilen);
            try {
              localStorage.setItem("tema", secilen);
            } catch (e) {}
            isaretle();
          });
        });

        // Secim yapilmadiysa sistem temasi degistiginde isaret de kaysin.
        koyuSorgu.addEventListener("change", isaretle);

        isaretle();
      })();
    </script>

    <script is:inline>
      // Sayfanın kendi ağırlığını Performance API'sinden okuyor. Hiçbir şey
      // uydurulmuyor: transferSize tarayıcının gerçekten indirdiği bayt.
      //
      // Önbellekten gelen kaynaklarda transferSize 0 döner; o durumda
      // encodedBodySize'a düşüyoruz, yoksa "0 KB" gibi yanlış bir rakam çıkar.
      (function () {
        var kutu = document.querySelector("[data-olcum]");
        if (!kutu || !window.performance || !performance.getEntriesByType) return;

        function bayt(e) {
          return e.transferSize || e.encodedBodySize || 0;
        }
        function kb(n) {
          return n < 1024 ? n + " B" : (n / 1024).toFixed(1).replace(".0", "") + " KB";
        }

        function olc() {
          var gezinme = performance.getEntriesByType("navigation")[0];
          var kaynaklar = performance.getEntriesByType("resource");
          if (!gezinme) return;

          var toplam = bayt(gezinme);
          var js = 0;
          for (var i = 0; i < kaynaklar.length; i++) {
            var b = bayt(kaynaklar[i]);
            toplam += b;
            if (/\.m?js(\?|$)/.test(kaynaklar[i].name)) js += b;
          }

          var ms = Math.round(gezinme.responseEnd - gezinme.startTime);
          var parcalar = [
            kb(toplam),
            1 + kaynaklar.length + " istek",
            kb(js) + " JS",
            ms + " ms",
          ];

          var hedef = kutu.querySelector("[data-olcum-agirlik]");
          if (hedef) hedef.textContent = parcalar.join(" · ");
          kutu.hidden = false;
        }


        // Yazı tipleri ve son kaynaklar da sayıya girsin diye load'dan sonra.
        if (document.readyState === "complete") setTimeout(olc, 300);
        else window.addEventListener("load", function () { setTimeout(olc, 300); });
      })();

    </script>

    <script is:inline>
      // ---- ARKA PLAN SESI ---------------------------------------------------
      // Ses bir kayittan gelmiyor; tarayicida uretiliyor. Uc katman var:
      //   1) Derin ugultu — iki osilator birbirinden 0.4 Hz sapmali, bu fark
      //      yavas bir dalgalanma (beating) yaratiyor, ses "canli" duruyor.
      //   2) Nefes — ust katmanin sesi cok yavas bir LFO ile inip cikiyor.
      //   3) Cizirtilar — rastgele araliklarla kisa, yuksek, cok kisik notalar.
      //
      // KENDILIGINDEN BASLAMAZ. Tarayicilar kullanici etkilesimi olmadan sesli
      // oynatmayi zaten engelliyor; ustelik habersiz baslayan ses rahatsiz
      // edici. Secim hatirlaniyor ama sayfa acilinca otomatik acilmiyor.
      (function () {
        var dugme = document.querySelector("[data-ses]");
        if (!dugme || !(window.AudioContext || window.webkitAudioContext)) return;

        var ctx = null, ana = null, dugumler = [], zamanlayici = null, acik = false;

        function kur() {
          var AC = window.AudioContext || window.webkitAudioContext;
          ctx = new AC();

          ana = ctx.createGain();
          ana.gain.value = 0;
          ana.connect(ctx.destination);

          // Ugultuyu bogan alcak geciren suzgec — tiz bilesenler kalmasin.
          var suzgec = ctx.createBiquadFilter();
          suzgec.type = "lowpass";
          suzgec.frequency.value = 240;
          suzgec.Q.value = 0.7;
          suzgec.connect(ana);

          [55, 55.4, 82.5].forEach(function (hz) {
            var o = ctx.createOscillator();
            o.type = "triangle";
            o.frequency.value = hz;
            var g = ctx.createGain();
            g.gain.value = 0.5;
            o.connect(g).connect(suzgec);
            o.start();
            dugumler.push(o);
          });

          // Nefes: ust katmanin sesini 0.05 Hz ile inip cikartiyor.
          var ust = ctx.createOscillator();
          ust.type = "sine";
          ust.frequency.value = 110;
          var ustG = ctx.createGain();
          ustG.gain.value = 0.12;
          var lfo = ctx.createOscillator();
          lfo.frequency.value = 0.05;
          var lfoG = ctx.createGain();
          lfoG.gain.value = 0.1;
          lfo.connect(lfoG).connect(ustG.gain);
          ust.connect(ustG).connect(ana);
          ust.start();
          lfo.start();
          dugumler.push(ust, lfo);
        }

        // Seyrek, kisa, kisik cizirtilar.
        function cizirti() {
          if (!ctx || !acik) return;
          var notalar = [880, 1046.5, 1174.7, 1318.5, 1568];
          var o = ctx.createOscillator();
          o.type = "sine";
          o.frequency.value = notalar[Math.floor(Math.random() * notalar.length)];
          var g = ctx.createGain();
          var pan = ctx.createStereoPanner ? ctx.createStereoPanner() : null;
          if (pan) pan.pan.value = Math.random() * 1.6 - 0.8;
          var t = ctx.currentTime;
          g.gain.setValueAtTime(0, t);
          g.gain.linearRampToValueAtTime(0.05, t + 0.01);
          g.gain.exponentialRampToValueAtTime(0.0001, t + 0.35);
          o.connect(g);
          (pan ? g.connect(pan).connect(ana) : g.connect(ana));
          o.start(t);
          o.stop(t + 0.4);
          zamanlayici = setTimeout(cizirti, 1800 + Math.random() * 3500);
        }

        function ac() {
          if (!ctx) kur();
          if (ctx.state === "suspended") ctx.resume();
          acik = true;
          ana.gain.cancelScheduledValues(ctx.currentTime);
          ana.gain.setValueAtTime(ana.gain.value, ctx.currentTime);
          ana.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 2.5);
          clearTimeout(zamanlayici);
          zamanlayici = setTimeout(cizirti, 1200);
          dugme.setAttribute("aria-pressed", "true");
          try { localStorage.setItem("ses", "acik"); } catch (e) {}
        }

        function kapat() {
          acik = false;
          clearTimeout(zamanlayici);
          if (ctx && ana) {
            ana.gain.cancelScheduledValues(ctx.currentTime);
            ana.gain.setValueAtTime(ana.gain.value, ctx.currentTime);
            ana.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.6);
          }
          dugme.setAttribute("aria-pressed", "false");
          try { localStorage.setItem("ses", "kapali"); } catch (e) {}
        }

        dugme.addEventListener("click", function () {
          acik ? kapat() : ac();
        });

        // Sekme arkaya gecince sesi kes, donunce geri getir; baska sekmede
        // calan ses en can sikici seylerden biri.
        document.addEventListener("visibilitychange", function () {
          if (!ctx) return;
          if (document.hidden) ctx.suspend();
          else if (acik) ctx.resume();
        });
      })();
    </script>

    <script is:inline>
      // ---- ATIS -------------------------------------------------------------
      // Nisangah gercekten ates ediyor: tiklanan noktada patlama, uretilen bir
      // tufek sesi, sag ustte dusen mermi sayaci. R sarjoru degistiriyor.
      // Metnin iki yanindaki bos kolonlarda gezen figurler vurulabiliyor;
      // vurus sayisi tarayicida saklaniyor.
      //
      // NEREYE ATES EDILIR:
      //   Once her yere ediliyordu. Ust uste hizli tiklayinca tarayici bunu
      //   cift/uclu tiklama sayiyor, layout icindeki metni seciyor, Edge de o
      //   secim icin kendi kucuk menusunu aciyordu. Simdi metnin uzerinde ates
      //   edilmiyor ve edilen her yerde preventDefault cagriliyor — secim hic
      //   baslamiyor, dolayisiyla o menu de cikmiyor.
      (function () {
        if (window.matchMedia("(hover: none)").matches) return;

        // Bu iki liste global.css'teki imlec kurallarinin aynisi: nisangah
        // gorunen yerde ates edilir, metin imleci gorunen yerde edilmez.
        // Kullanici nereye ates edebilecegini imlecin kendisinden anliyor.
        var ETKILESIMLI = "a, button, [role='button'], label, input, textarea, select, summary";
        var METIN = "p, h1, h2, h3, li, code, pre, .icerik";

        var SARJOR = 30;
        var kalan = SARJOR;
        var vurus = 0;
        var ctx = null;

        var mermiEl = document.querySelector("[data-mermi]");
        var kalanEl = document.querySelector("[data-mermi-kalan]");
        var vurusEl = document.querySelector("[data-vurus-sayi]");
        var vurusKutu = document.querySelector("[data-vurus]");

        try {
          vurus = parseInt(localStorage.getItem("vurus"), 10) || 0;
        } catch (e) {
          /* gizli sekmede localStorage erisimi hata verebilir */
        }

        function iki(n) {
          return n < 10 ? "0" + n : String(n);
        }

        function mermiYaz() {
          if (kalanEl) kalanEl.textContent = String(kalan);
          if (mermiEl) mermiEl.setAttribute("data-bos", kalan === 0 ? "evet" : "hayir");
        }

        function vurusYaz(yeni) {
          if (vurusEl) vurusEl.textContent = iki(vurus);
          if (yeni && vurusKutu) {
            vurusKutu.classList.remove("arti");
            void vurusKutu.offsetWidth; // animasyonu bastan tetikle
            vurusKutu.classList.add("arti");
          }
          try {
            localStorage.setItem("vurus", String(vurus));
          } catch (e) {}
        }

        // ---- ses ------------------------------------------------------------

        function baglam() {
          var AC = window.AudioContext || window.webkitAudioContext;
          if (!AC) return null;
          if (!ctx) ctx = new AC();
          if (ctx.state === "suspended") ctx.resume();
          return ctx;
        }

        /** Ses uretimini sarmaliyor: ses calismazsa efekt yine gorunsun. */
        function cal(fn) {
          try {
            if (baglam()) fn();
          } catch (e) {}
        }

        /** Sonme egrili gurultu tamponu. */
        function gurultu(saniye, egri) {
          var n = Math.floor(ctx.sampleRate * saniye);
          var b = ctx.createBuffer(1, n, ctx.sampleRate);
          var d = b.getChannelData(0);
          for (var i = 0; i < n; i++) {
            d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / n, egri);
          }
          return b;
        }

        // Yumusak kirpma. Temiz gurultu cansiz duruyor; kirpma sese kagit
        // yirtilmasina benzeyen o sert dokuyu katiyor.
        var kirpmaEgrisi = null;
        function kirpici() {
          if (!kirpmaEgrisi) {
            var n = 1024;
            kirpmaEgrisi = new Float32Array(n);
            for (var i = 0; i < n; i++) {
              kirpmaEgrisi[i] = Math.tanh(((i / (n - 1)) * 2 - 1) * 2.4);
            }
          }
          var w = ctx.createWaveShaper();
          w.curve = kirpmaEgrisi;
          w.oversample = "2x";
          return w;
        }

        /** Suzgecten gecirilmis tek gurultu katmani. */
        function katman(o) {
          var k = ctx.createBufferSource();
          k.buffer = gurultu(o.sure, o.egri);
          var f = ctx.createBiquadFilter();
          f.type = o.tur;
          f.frequency.value = o.frekans;
          if (o.q) f.Q.value = o.q;
          var g = ctx.createGain();
          g.gain.value = o.kazanc;
          var zincir = k.connect(f);
          if (o.grit) zincir = zincir.connect(kirpici());
          zincir.connect(g).connect(ctx.destination);
          k.start(ctx.currentTime + (o.gecikme || 0));
        }

        // AK-47: tek bir patlama degil, ust uste binen bes katman. Karakter
        // katmanlarin zamanlamasindan geliyor — ozellikle 70 ms sonra gelen
        // surgu klik'inden. O olmadan ses "patlama" gibi kaliyor, "silah"
        // gibi olmuyor. Her atista frekanslar hafifce oynatiliyor, yoksa ust
        // uste tiklayinca zil sesi gibi ayni ses tekrarliyor.
        function atisSesi() {
          var s = 0.92 + Math.random() * 0.16;

          // 1) CATLAMA — 14 ms, cok tiz. Namlunun kirbaci.
          katman({ sure: 0.014, egri: 1.1, tur: "highpass", frekans: 2600 * s, kazanc: 0.2 });

          // 2) GOVDE — 80 ms, orta bant, gritli. Patlamanin eti.
          katman({ sure: 0.08, egri: 2.6, tur: "bandpass", frekans: 620 * s, q: 0.8, kazanc: 0.26, grit: true, gecikme: 0.002 });

          // 3) SUB — alcak supurme. Gogsunde duydugun vurus.
          var t = ctx.currentTime;
          var osc = ctx.createOscillator();
          osc.type = "sine";
          osc.frequency.setValueAtTime(190 * s, t);
          osc.frequency.exponentialRampToValueAtTime(42, t + 0.085);
          var og = ctx.createGain();
          og.gain.setValueAtTime(0.001, t);
          og.gain.exponentialRampToValueAtTime(0.2, t + 0.004);
          og.gain.exponentialRampToValueAtTime(0.0001, t + 0.12);
          osc.connect(og).connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.14);

          // 4) KUYRUK — 450 ms, bogulmus. Cevrenin yansimasi.
          katman({ sure: 0.45, egri: 4.5, tur: "lowpass", frekans: 950, kazanc: 0.06, gecikme: 0.012 });

          // 5) SURGU — metalik kisa klik: mekanizmanin kurulmasi.
          katman({ sure: 0.03, egri: 2, tur: "bandpass", frekans: 3400, q: 3, kazanc: 0.07, gecikme: 0.07 });
        }

        /** Sarjor bos: sadece tetigin kuru klik'i. */
        function kuruAtis() {
          katman({ sure: 0.022, egri: 2, tur: "bandpass", frekans: 2300, q: 4, kazanc: 0.06 });
        }

        /** Sarjor degisimi: cikan sarjor, giren sarjor, surgu. */
        function sarjorSesi() {
          katman({ sure: 0.035, egri: 2, tur: "bandpass", frekans: 1500, q: 2.5, kazanc: 0.09 });
          katman({ sure: 0.045, egri: 2, tur: "bandpass", frekans: 1100, q: 2.5, kazanc: 0.11, gecikme: 0.14 });
          katman({ sure: 0.05, egri: 1.8, tur: "bandpass", frekans: 2800, q: 3, kazanc: 0.1, gecikme: 0.3 });
        }

        /** Hedef vuruldu: iki tizden metalik bir ting. */
        function vurusSesi() {
          var t = ctx.currentTime + 0.04;
          [1720, 2580].forEach(function (hz, i) {
            var o = ctx.createOscillator();
            o.type = "square";
            o.frequency.value = hz;
            var g = ctx.createGain();
            g.gain.setValueAtTime(0.0001, t);
            g.gain.exponentialRampToValueAtTime(i ? 0.028 : 0.045, t + 0.003);
            g.gain.exponentialRampToValueAtTime(0.0001, t + 0.16);
            o.connect(g).connect(ctx.destination);
            o.start(t);
            o.stop(t + 0.18);
          });
        }

        // ---- gorsel ---------------------------------------------------------

        function patlama(x, y) {
          var el = document.createElement("div");
          el.className = "atis";
          el.style.left = x + "px";
          el.style.top = y + "px";
          document.body.appendChild(el);
          setTimeout(function () {
            el.remove();
          }, 400);
        }

        // ---- kenar hedefleri ------------------------------------------------
        // Figurler yalnizca icerik kolonunun DISINDA duruyor; metnin ustune
        // hicbir sey binmiyor. Yeterli bosluk yoksa (dar ekran, buyutulmus
        // yazi) hic olusturulmuyorlar.

        var GEN = 22, BOY = 40, PAY = 14, EN_AZ_KOLON = 74, ADET = 3;
        var saha = null;

        function kolonlar() {
          var m = document.querySelector("main");
          if (!m) return [];
          var r = m.getBoundingClientRect();
          var liste = [];
          if (r.left - PAY * 2 >= EN_AZ_KOLON) liste.push([PAY, r.left - PAY]);
          if (window.innerWidth - r.right - PAY * 2 >= EN_AZ_KOLON) {
            liste.push([r.right + PAY, window.innerWidth - PAY]);
          }
          return liste;
        }

        function yerlestir(el, kolon) {
          var h = window.innerHeight;

          // Yatay salinim ONCE seciliyor, cunku baslangic noktasi ona gore
          // daraltiliyor. Tersi sirada figur salinirken metin kolonunun
          // kenarina girip yaziyi kapatiyordu.
          var kay = Math.round(Math.random() * 40 - 20);
          var enSol = kolon[0] + Math.max(0, -kay);
          var enSag = kolon[1] - GEN - Math.max(0, kay);
          var x = enSol + Math.random() * Math.max(1, enSag - enSol);

          // Dusey gezinme de ayni mantikla sinirli: hangi yonde daha cok yer
          // varsa o yone, sadece sigdigi kadar.
          var y = 60 + Math.random() * Math.max(40, h - 260);
          var istek = 60 + Math.random() * 150;
          var asagi = h - 30 - (y + BOY);
          var yukari = y - 20;
          var mesafe = asagi >= yukari
            ? Math.max(0, Math.min(asagi, istek))
            : -Math.max(0, Math.min(yukari, istek));

          el.style.left = Math.round(x) + "px";
          el.style.top = Math.round(y) + "px";
          el.style.setProperty("--mesafe", Math.round(mesafe) + "px");
          el.style.setProperty("--kay", kay + "px");
          el.style.setProperty("--sure", (7 + Math.random() * 8).toFixed(1) + "s");
          // Negatif gecikme animasyonu ortasindan baslatiyor; boylece figurler
          // ayni anda ayni yonde hareket etmiyor.
          el.style.setProperty("--gecikme", "-" + (Math.random() * 12).toFixed(1) + "s");
        }

        function figurEkle(kolon) {
          var el = document.createElement("div");
          el.className = "hedef";
          el.setAttribute("aria-hidden", "true");
          el.appendChild(document.createElement("i"));
          yerlestir(el, kolon);
          saha.appendChild(el);
        }

        function sahaKur() {
          var liste = kolonlar();
          if (!saha) {
            if (!liste.length) return;
            saha = document.createElement("div");
            saha.className = "saha";
            saha.setAttribute("aria-hidden", "true");
            document.body.appendChild(saha);
          }
          saha.textContent = "";
          for (var i = 0; i < liste.length; i++) {
            for (var j = 0; j < ADET; j++) figurEkle(liste[i]);
          }
        }

        function devir(el) {
          el.classList.add("vuruldu");
          vurus++;
          vurusYaz(true);
          cal(vurusSesi);
          // Devrilen figurun yerine bir sure sonra yenisi geliyor; saha
          // bosalmasin ama aninda da dolmasin.
          setTimeout(function () {
            el.remove();
            var liste = kolonlar();
            if (saha && liste.length) {
              figurEkle(liste[Math.floor(Math.random() * liste.length)]);
            }
          }, 900 + Math.random() * 1600);
        }

        sahaKur();

        // Pencere boyutu degisince kolonlarin yeri de degisiyor: figurler
        // metnin ustunde kalmasin diye sahayi bastan kuruyoruz.
        var boyutZamani = null;
        window.addEventListener("resize", function () {
          clearTimeout(boyutZamani);
          boyutZamani = setTimeout(sahaKur, 250);
        });

        // ---- tetik ----------------------------------------------------------

        document.addEventListener("mousedown", function (olay) {
          if (olay.button !== 0) return;
          var hedef = olay.target;
          if (!hedef || hedef.nodeType !== 1) return;

          var figur = hedef.closest(".hedef");
          if (!figur) {
            if (hedef.closest(ETKILESIMLI)) return; // tiklamanin kendi isi var
            if (hedef.closest(METIN)) return; // metin secilebilir kalsin
          }

          // Ekranda secim varsa ilk tik onu temizlesin; secimi kaldiran tikla
          // ayni anda ates etmek rahatsiz ediciydi.
          var secim = window.getSelection();
          if (secim && !secim.isCollapsed) {
            secim.removeAllRanges();
            return;
          }

          // Cift/uclu tiklamanin metin secmesini bastan engelliyor.
          olay.preventDefault();

          if (kalan <= 0) {
            cal(kuruAtis);
            return;
          }
          kalan--;
          mermiYaz();
          patlama(olay.clientX, olay.clientY);
          cal(atisSesi);
          if (figur && !figur.classList.contains("vuruldu")) devir(figur);
        });

        document.addEventListener("keydown", function (olay) {
          if (olay.key !== "r" && olay.key !== "R") return;
          if (olay.ctrlKey || olay.metaKey || olay.altKey) return; // Ctrl+R yenileme
          var odak = document.activeElement;
          if (odak && /^(INPUT|TEXTAREA|SELECT)$/.test(odak.tagName)) return;
          if (kalan === SARJOR) return;

          kalan = SARJOR;
          mermiYaz();
          cal(sarjorSesi);
          if (mermiEl) {
            mermiEl.classList.remove("doldu");
            void mermiEl.offsetWidth;
            mermiEl.classList.add("doldu");
          }
        });

        mermiYaz();
        vurusYaz(false);
      })();
    </script>
  </body>
</html>
