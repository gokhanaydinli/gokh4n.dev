---
// ============================================================================
// Tüm sayfaların paylaştığı kabuk: <head>, künye, gezinme, alt bilgi.
//
// Sayfalar sadece kendi içeriğini yazar; başlık/menü/footer buradan gelir.
// Böylece menüye bir bağlantı eklemek tek dosyada değişiklik demek.
// ============================================================================
import { SURUM } from "../surum";
import "../styles/global.css";

interface Props {
  baslik: string;
  aciklama?: string;
  /** Gezinmede hangi bağlantı işaretli olacak. */
  aktif?: "ana" | "blog";
}

const {
  baslik,
  aciklama = "Blog ve çalışmalar.",
  aktif,
} = Astro.props;

const yil = new Date().getFullYear();
const kanonik = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />

    {/* Tema secimi sayfa boyanmadan ONCE uygulanmali. Aksi halde koyu tema
        secili olsa bile her acilista bir anlik beyaz parlama olur. Bu yuzden
        burada, <body>'den once, senkron calisiyor. */}
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add("js");
        try {
          var t = localStorage.getItem("tema");
          if (t === "koyu" || t === "acik") h.setAttribute("data-tema", t);
        } catch (e) {
          /* gizli sekmede localStorage erisimi hata verebilir */
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{baslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={kanonik} />

    {/* Site şimdilik aramaya kapalı. Açmak istendiğinde bu satır kalkar
        ve public/robots.txt güncellenir — iki yerde tek değişiklik. */}
    <meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={baslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={kanonik} />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23e9e6df'/><rect x='3' y='3' width='26' height='26' fill='none' stroke='%230d0d0d' stroke-width='3'/><rect x='10' y='10' width='12' height='12' fill='%23ff3b00'/></svg>"
    />

    <link rel="alternate" type="application/rss+xml" title="gokh4n.dev" href="/rss.xml" />

    {/* Speculation Rules — sayfa gecislerini anlik yapar.
        Tarayiciya "kullanici bu baglantiya gitmek uzere gorunuyorsa sayfayi
        simdiden hazirla" diyor. eagerness: moderate = imlec baglantinin
        uzerine gelince (masaustu) ya da parmak dokununca (mobil).

        ClientRouter'dan farki: hic JavaScript calismiyor, bu sadece
        bildirimsel bir ipucu. Destekleyen tarayici (Chrome, Edge, Android
        Chrome) faydalaniyor; desteklemeyen (Safari) gormezden geliyor,
        hicbir maliyeti olmuyor. */}
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          { "where": { "href_matches": "/*" }, "eagerness": "moderate" }
        ]
      }
    </script>

  </head>

  <body>
    <main>
      <div class="cerceve">
        <div class="hucre kunye-satir">
          <a class="kunye" href="/">
            gokh4n<b>.</b>dev
          </a>

          <div class="ust-sag">
            {/* Canlı saat. Site statik derlendiği için derleme anındaki
                tarihi basmak yanlış olur; değerleri tarayıcı yazıyor
                (betik sayfanın sonunda). */}
            <div class="saat" aria-hidden="true">
              <span class="saat-ust">
                <span data-saat="gun">&nbsp;</span>
                <span class="ayirac">·</span>
                <span data-saat="tarih">&nbsp;</span>
              </span>
              <span data-saat="vakit">&nbsp;</span>
            </div>

            <div class="tema-secici" role="group" aria-label="Tema">
              <button type="button" data-tema-sec="acik">Açık</button>
              <button type="button" data-tema-sec="koyu">Koyu</button>
            </div>
          </div>
        </div>

        <nav class="gezinme">
          <a href="/" aria-current={aktif === "ana" ? "page" : undefined}>
            Çalışmalar
          </a>
          <a href="/blog/" aria-current={aktif === "blog" ? "page" : undefined}>
            Blog
          </a>
        </nav>

        <slot />

        {/* ÖLÇÜM ŞERİDİ
            Üst satır: bu sayfanın gerçek ağırlığı. Uydurma değil, tarayıcının
            Performance API'sinden okunuyor — ziyaretçi ne indirdiyse o.
            Alt satır: yayındaki commit, derleme anında git'ten alındı.

            Sayfa ilk boyandığında değerler henüz belli olmadığı için şerit
            gizli duruyor; ölçüm bitince açılıyor. Böylece boş satır görünmüyor. */}
        <div class="hucre olcum" data-olcum hidden>
          <div class="olcum-satir">
            <span class="olcum-etiket">Bu sayfa</span>
            <span class="olcum-deger" data-olcum-agirlik>—</span>
          </div>
          {SURUM.commit && (
            <div class="olcum-satir">
              <span class="olcum-etiket">Sürüm</span>
              <span class="olcum-deger">
                {SURUM.adres ? (
                  <a href={SURUM.adres} target="_blank" rel="noreferrer">
                    {SURUM.commit}
                  </a>
                ) : (
                  SURUM.commit
                )}
                {SURUM.zaman && (
                  <>
                    {" · "}
                    <span data-olcum-yas={SURUM.zaman}>—</span>
                  </>
                )}
              </span>
            </div>
          )}
        </div>

        <script is:inline>
          (function () {
            var gun = document.querySelector('[data-saat="gun"]');
            var tarih = document.querySelector('[data-saat="tarih"]');
            var vakit = document.querySelector('[data-saat="vakit"]');
            if (!gun || !tarih || !vakit) return;

            var gunBicimi = new Intl.DateTimeFormat("tr-TR", { weekday: "long" });
            var tarihBicimi = new Intl.DateTimeFormat("tr-TR", {
              day: "2-digit",
              month: "2-digit",
              year: "numeric",
            });
            var vakitBicimi = new Intl.DateTimeFormat("tr-TR", {
              hour: "2-digit",
              minute: "2-digit",
              second: "2-digit",
              hour12: false,
            });

            function yaz() {
              var t = new Date();
              gun.textContent = gunBicimi.format(t);
              tarih.textContent = tarihBicimi.format(t);
              vakit.textContent = vakitBicimi.format(t);
            }

            yaz();
            setInterval(yaz, 1000);
          })();
        </script>
      </div>

      <footer>
        <span>© {yil}</span>
        <a href="https://github.com/gokhanaydinli" target="_blank" rel="noreferrer" lang="en">
          GitHub ↗
        </a>
      </footer>
    </main>

    <script is:inline>
      (function () {
        var dugmeler = document.querySelectorAll("[data-tema-sec]");
        if (!dugmeler.length) return;

        var koyuSorgu = window.matchMedia("(prefers-color-scheme: dark)");

        // Kullanici bir sey secmediyse sistem temasi gecerli sayilir.
        function etkinTema() {
          var secim = document.documentElement.getAttribute("data-tema");
          if (secim === "koyu" || secim === "acik") return secim;
          return koyuSorgu.matches ? "koyu" : "acik";
        }

        function isaretle() {
          var simdiki = etkinTema();
          dugmeler.forEach(function (d) {
            d.setAttribute(
              "aria-pressed",
              d.dataset.temaSec === simdiki ? "true" : "false"
            );
          });
        }

        dugmeler.forEach(function (d) {
          d.addEventListener("click", function () {
            var secilen = d.dataset.temaSec;
            document.documentElement.setAttribute("data-tema", secilen);
            try {
              localStorage.setItem("tema", secilen);
            } catch (e) {}
            isaretle();
          });
        });

        // Secim yapilmadiysa sistem temasi degistiginde isaret de kaysin.
        koyuSorgu.addEventListener("change", isaretle);

        isaretle();
      })();
    </script>

    <script is:inline>
      // Sayfanın kendi ağırlığını Performance API'sinden okuyor. Hiçbir şey
      // uydurulmuyor: transferSize tarayıcının gerçekten indirdiği bayt.
      //
      // Önbellekten gelen kaynaklarda transferSize 0 döner; o durumda
      // encodedBodySize'a düşüyoruz, yoksa "0 KB" gibi yanlış bir rakam çıkar.
      (function () {
        var kutu = document.querySelector("[data-olcum]");
        if (!kutu || !window.performance || !performance.getEntriesByType) return;

        function bayt(e) {
          return e.transferSize || e.encodedBodySize || 0;
        }
        function kb(n) {
          return n < 1024 ? n + " B" : (n / 1024).toFixed(1).replace(".0", "") + " KB";
        }

        function olc() {
          var gezinme = performance.getEntriesByType("navigation")[0];
          var kaynaklar = performance.getEntriesByType("resource");
          if (!gezinme) return;

          var toplam = bayt(gezinme);
          var js = 0;
          for (var i = 0; i < kaynaklar.length; i++) {
            var b = bayt(kaynaklar[i]);
            toplam += b;
            if (/\.m?js(\?|$)/.test(kaynaklar[i].name)) js += b;
          }

          var ms = Math.round(gezinme.responseEnd - gezinme.startTime);
          var parcalar = [
            kb(toplam),
            1 + kaynaklar.length + " istek",
            kb(js) + " JS",
            ms + " ms",
          ];

          var hedef = kutu.querySelector("[data-olcum-agirlik]");
          if (hedef) hedef.textContent = parcalar.join(" · ");
          kutu.hidden = false;
        }

        // "2 sa önce" gibi göreli zaman.
        function yasYaz() {
          var el = kutu.querySelector("[data-olcum-yas]");
          if (!el) return;
          var t = new Date(el.getAttribute("data-olcum-yas")).getTime();
          if (!t) return;
          var dk = Math.max(0, Math.round((Date.now() - t) / 60000));
          el.textContent =
            dk < 1 ? "az önce"
            : dk < 60 ? dk + " dk önce"
            : dk < 1440 ? Math.round(dk / 60) + " sa önce"
            : Math.round(dk / 1440) + " gün önce";
        }

        yasYaz();
        // Yazı tipleri ve son kaynaklar da sayıya girsin diye load'dan sonra.
        if (document.readyState === "complete") setTimeout(olc, 300);
        else window.addEventListener("load", function () { setTimeout(olc, 300); });
      })();

    </script>
  </body>
</html>
